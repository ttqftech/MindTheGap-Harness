{
	// 根 tsconfig 双职责（参考 FFBox：根 tsconfig 仅聚合子项目）：
	// 1. references 聚合 config/ 下的前后端两套 tsconfig，IDE 按文件自动归属正确的类型上下文
	// 2. compilerOptions 供 hutch 打包主进程（bun build 只读最近的 tsconfig.json = 本文件）使用，因此必须内联展开 .hutch/devkit/tsconfig.json 的 electrobun paths，并补充项目自身 alias
	//    bun 进程直接走 hutch electrobun build，不走 vite build，因此这里的 paths 是必要的
	"compilerOptions": {
		// baseUrl 保留说明：TS 5.x 已不要求 paths 依赖 baseUrl（paths 可相对 tsconfig 解析），
		// 但本文件是 hutch 打主进程时 bun build 读取的配置，bun 对「无 baseUrl 的 paths」支持不如 TS 完善，保留 baseUrl "." 最稳。
		// config/ 下的子项目通过 extends 继承 baseUrl+paths，无需各自展开。
		"baseUrl": ".",
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": false,	// 虽然 TypeScript 在本项目中不生成产物，理应设置 noEmit，但 composite: true 时，noEmit 只能是 false，在 compiler 里设置输出废物位置 outDir 并排除掉即可
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		// bun-types 与 @types/node 版本错位（TextEncoderEncodeIntoResult / ConnectionOptions / TLSSocket 互相引用报错），
		// skipLibCheck 跳过第三方 .d.ts 检查兜底，项目源码仍全量严格（见 AGENTS.md 易错点）
		"skipLibCheck": true,
		"paths": {
			// ---- 以下由 .hutch/devkit/tsconfig.json 展开（相对本文件 = 项目根）----
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main/app-menu": ["./.hutch/devkit/api/sdks/main/entries/app-menu.ts"],
			"electrobun/main/browser-view": ["./.hutch/devkit/api/sdks/main/entries/browser-view.ts"],
			"electrobun/main/browser-window": ["./.hutch/devkit/api/sdks/main/entries/browser-window.ts"],
			"electrobun/main/build-config": ["./.hutch/devkit/api/sdks/main/entries/build-config.ts"],
			"electrobun/main/context-menu": ["./.hutch/devkit/api/sdks/main/entries/context-menu.ts"],
			"electrobun/main/events": ["./.hutch/devkit/api/sdks/main/entries/events.ts"],
			"electrobun/main/gpu-window": ["./.hutch/devkit/api/sdks/main/entries/gpu-window.ts"],
			"electrobun/main/native": ["./.hutch/devkit/api/sdks/main/entries/native.ts"],
			"electrobun/main/paths": ["./.hutch/devkit/api/sdks/main/entries/paths.ts"],
			"electrobun/main/rpc": ["./.hutch/devkit/api/sdks/main/entries/rpc.ts"],
			"electrobun/main/socket": ["./.hutch/devkit/api/sdks/main/entries/socket.ts"],
			"electrobun/main/tray": ["./.hutch/devkit/api/sdks/main/entries/tray.ts"],
			"electrobun/main/ui": ["./.hutch/devkit/api/sdks/main/entries/ui.ts"],
			"electrobun/main/ui/jsx-runtime": ["./.hutch/devkit/api/sdks/main/ui/jsx-runtime.ts"],
			"electrobun/main/ui/jsx-dev-runtime": ["./.hutch/devkit/api/sdks/main/ui/jsx-dev-runtime.ts"],
			"electrobun/main/updater": ["./.hutch/devkit/api/sdks/main/entries/updater.ts"],
			"electrobun/main/utils": ["./.hutch/devkit/api/sdks/main/entries/utils.ts"],
			"electrobun/main/webgpu": ["./.hutch/devkit/api/sdks/main/entries/webgpu.ts"],
			"electrobun/main/wgpu-view": ["./.hutch/devkit/api/sdks/main/entries/wgpu-view.ts"],
			"electrobun/bun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/bun/app-menu": ["./.hutch/devkit/api/sdks/main/entries/app-menu.ts"],
			"electrobun/bun/browser-view": ["./.hutch/devkit/api/sdks/main/entries/browser-view.ts"],
			"electrobun/bun/browser-window": ["./.hutch/devkit/api/sdks/main/entries/browser-window.ts"],
			"electrobun/bun/build-config": ["./.hutch/devkit/api/sdks/main/entries/build-config.ts"],
			"electrobun/bun/context-menu": ["./.hutch/devkit/api/sdks/main/entries/context-menu.ts"],
			"electrobun/bun/events": ["./.hutch/devkit/api/sdks/main/entries/events.ts"],
			"electrobun/bun/gpu-window": ["./.hutch/devkit/api/sdks/main/entries/gpu-window.ts"],
			"electrobun/bun/native": ["./.hutch/devkit/api/sdks/main/entries/native.ts"],
			"electrobun/bun/paths": ["./.hutch/devkit/api/sdks/main/entries/paths.ts"],
			"electrobun/bun/rpc": ["./.hutch/devkit/api/sdks/main/entries/rpc.ts"],
			"electrobun/bun/socket": ["./.hutch/devkit/api/sdks/main/entries/socket.ts"],
			"electrobun/bun/tray": ["./.hutch/devkit/api/sdks/main/entries/tray.ts"],
			"electrobun/bun/ui": ["./.hutch/devkit/api/sdks/main/entries/ui.ts"],
			"electrobun/bun/ui/jsx-runtime": ["./.hutch/devkit/api/sdks/main/ui/jsx-runtime.ts"],
			"electrobun/bun/ui/jsx-dev-runtime": ["./.hutch/devkit/api/sdks/main/ui/jsx-dev-runtime.ts"],
			"electrobun/bun/updater": ["./.hutch/devkit/api/sdks/main/entries/updater.ts"],
			"electrobun/bun/utils": ["./.hutch/devkit/api/sdks/main/entries/utils.ts"],
			"electrobun/bun/webgpu": ["./.hutch/devkit/api/sdks/main/entries/webgpu.ts"],
			"electrobun/bun/wgpu-view": ["./.hutch/devkit/api/sdks/main/entries/wgpu-view.ts"],
			"electrobun/rpc": ["./.hutch/devkit/api/sdks/main/entries/rpc.ts"],
			"electrobun/view": ["./.hutch/devkit/api/browser/index.ts"],
			"electrobun/browser/ui": ["./.hutch/devkit/api/browser/ui/index.ts"],
			"electrobun/browser/ui/jsx-runtime": ["./.hutch/devkit/api/browser/ui/jsx-runtime.ts"],
			"electrobun/browser/ui/jsx-dev-runtime": ["./.hutch/devkit/api/browser/ui/jsx-dev-runtime.ts"],
			// ---- 项目自身 alias（config/ 子项目经 extends 继承，不再各自声明）----
			"@shared/*": ["./src/shared/*"],
			"@mainview/*": ["./src/mainview/*"],
			"@bun/*": ["./src/bun/*"],
			// FFBox-UI 未发布 npm，vite 经 vendor alias 解析；TS 不认 vite alias，必须在此给 paths 一条映射
			// 到 vendor 构建产物的真实 .d.ts（FFBox-UI 0.7.0 起 dist 自带类型）。组件 d.ts 引用 lit/lit-html，
			// 已加为 devDependencies（纯类型用途；运行时产物自包含 lit，不打包）。
			"ffbox-ui": ["./vendor/ffbox-ui/dist/esm/ffbox-ui.d.ts"]
		}
	},
	"references": [
		{ "path": "./config/tsconfig.bun.json" },
		{ "path": "./config/tsconfig.mainview.json" }
	],
	"files": []
}
