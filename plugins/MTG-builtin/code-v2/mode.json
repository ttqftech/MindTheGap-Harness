						"tierName": "深度",
						"maxDepth": 3,
						"totalRounds": 85,
						"agentInstanceRounds": 20,
						"rIntent": 2,
						"rPlan": 1,
						"rEngineer": 2,
						"rReview": 1,
						"taskListEnabled": true,
						"taskListWritable": true,
