						"rootAgents": ["explore", "plan", "engineer", "verify", "review"],
						"engineerAgents": ["explore", "engineer"]
					}
				},
				{
					"label": "极致 · 穷举",
					"value": "ultra",
					"description": "阶段化推进 + 每阶段增量验证 + 全文审查 + 需求逐条回读；140 轮 / 深度 4 / 反思 3",
