						"rPlan": 0,
						"rEngineer": 0,
						"rReview": 0,
						"taskListEnabled": false,
						"taskListWritable": false,
						"isLite": true,
						"isStandard": false,
						"isDeep": false,
						"isMax": false,
						"isStaged": false,
						"rootAgents": ["engineer"],
						"engineerAgents": []
					}
				},
				{
					"label": "中 · 标准",
					"value": "medium",
					"description": "探索 → 执行 → 验证，不写计划文档；50 轮 / 深度 2 / 反思 1",
