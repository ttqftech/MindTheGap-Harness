						"isDeep": false,
						"isMax": false,
						"isStaged": false,
						"rootAgents": ["explore", "engineer", "verify"],
						"engineerAgents": []
					}
				},
				{
					"label": "高 · 深度",
					"value": "high",
					"description": "并行探索 → 写计划 → 分阶段执行 → 审查 + 验证；85 轮 / 深度 3 / 反思 2",
